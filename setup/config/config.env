# Configuration for setup/scripts/install.sh. It is a bash file: install.sh sources it.
# To change it, copy it outside the repository and pass the copy in LOCAL_CONFIG:
#
#   LOCAL_CONFIG=$HOME/observability-platform/config.env setup/scripts/install.sh
#
# A variable set in the environment wins over this file: `make local-up` turns every
# toggle on that way. See docs/INSTALL.md.
#
# Toggles take `true` or `false`. Turn a component on when the cluster doesn't run it yet.
# With the toggles off, install.sh installs the operators and the chart only, and turns
# off the chart features whose prerequisites are missing.

# --- Target cluster ----------------------------------------------------------

# kubeconfig context to install into. Empty uses the current context.
KUBE_CONTEXT=

# --- Prerequisites -----------------------------------------------------------

# Envoy Gateway, with the Gateway API CRDs, in envoy-gateway-system. Grafana's route, the
# external API and the agent write routes need it: while the cluster serves no Envoy
# Gateway CRDs, install.sh turns them off. See docs/GATEWAY.md.
INSTALL_ENVOY_GATEWAY=false
ENVOY_GATEWAY_VERSION=1.9.1

# The GatewayClass `envoy-gateway` and the Gateway `giantswarm-default` in
# envoy-gateway-system, which the chart's routes attach to. Leave it off when you bring
# your own Gateway: give it an HTTPS listener named `https`, or change the parentRefs in
# PLATFORM_VALUES.
CREATE_GATEWAY=false
# `kind` exposes the Gateway on NodePorts 30080 (HTTP) and 30443 (HTTPS), for a kind
# cluster without a LoadBalancer. `base` gets a LoadBalancer Service from your cluster.
GATEWAY_OVERLAY=kind

# cert-manager, in cert-manager, with Gateway API support. The barman-cloud plugin needs
# it. Leave it off when the cluster already runs cert-manager.
INSTALL_CERT_MANAGER=false
CERT_MANAGER_VERSION=v1.21.2

# --- Local issuer and certificate ---------------------------------------------

# A JWKS server and token signer in jwt-issuer, standing in for an OIDC issuer for the
# external API. Not for real use. Off, install.sh turns the external API off while
# PLATFORM_VALUES trusts this issuer: point observability-platform-api.auth.jwt at your
# own OIDC issuer to keep it on.
DEPLOY_JWT_ISSUER=false

# The Secret `local-https-tls` in envoy-gateway-system: a self-signed certificate for the
# Gateway's `https` listener, generated by the signer of DEPLOY_JWT_ISSUER. Not for real
# use. Leave it off when you create that Secret yourself, for example with cert-manager.
CREATE_TLS_SECRET=false

# --- Platform dependencies -----------------------------------------------------

# observability-operator. Always installed: the chart needs its CRDs.
OPERATOR_VERSION=0.88.0

# CloudNativePG operator, for Grafana's PostgreSQL database. Turn it off when the
# cluster already runs a CNPG operator that watches `monitoring`, or when Grafana stays
# on SQLite. See docs/GRAFANA_DATABASE.md.
INSTALL_CNPG=true
CNPG_VERSION=0.1.0

# The Secret `grafana-secret-key` in monitoring, with a random key, unless it exists.
# Grafana on PostgreSQL needs it. Turn it off when you create the Secret yourself.
CREATE_GRAFANA_SECRET_KEY=true

# barman-cloud plugin for CNPG, for backups of Grafana's PostgreSQL database to object
# storage, on the `s3` backend. It needs cert-manager. While the cluster serves no
# barman-cloud ObjectStore CRD, install.sh turns Grafana's backups off.
# See docs/GRAFANA_DATABASE.md.
INSTALL_PLUGIN_BARMAN_CLOUD=false
PLUGIN_BARMAN_CLOUD_VERSION=0.4.0

# --- Platform ------------------------------------------------------------------

# The Platform chart's values files, separated by spaces. Later files win. Relative paths
# are relative to the repository root. Point it at your copy of
# values/observability-platform.yaml, and add files of your own after it.
PLATFORM_VALUES=values/observability-platform.yaml

# The local profile, helm/observability-platform/values-local.yaml, under
# PLATFORM_VALUES: one replica per component and an object store in
# the cluster, sized for a laptop. Not for real use. Off, the chart gets PLATFORM_VALUES
# only: set your object storage there.
USE_LOCAL_PROFILE=false
# The store of the local profile: `s3` runs Garage, `azure` runs Azurite. Ignored with
# USE_LOCAL_PROFILE=false.
LOCAL_BACKEND=s3

# The Platform chart: an OCI reference, a chart directory or a packaged .tgz. Relative
# paths are relative to the repository root. A directory gets `helm dependency update`.
# install.sh's argument wins over it: `make local-up` and CI pass the repository's chart.
# The other charts always come from oci://gsoci.azurecr.io/charts/giantswarm.
PLATFORM_CHART=oci://gsoci.azurecr.io/charts/giantswarm/observability-platform
# The release of an OCI PLATFORM_CHART. Empty takes the latest. Until the chart's first
# release is out, set PLATFORM_CHART=helm/observability-platform instead.
PLATFORM_CHART_VERSION=0.1.0
