{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "observability-platform values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "storageClass": { "type": "string" },
        "tenant": { "type": "string", "minLength": 1 },
        "objectStorage": {
          "type": "object",
          "required": ["existingSecret", "azure", "buckets"],
          "properties": {
            "existingSecret": {
              "type": "string",
              "const": "observability-platform-object-storage",
              "description": "Fixed name. The Mimir and Loki values reference this Secret from static values. Create the credentials Secret with this name."
            },
            "azure": {
              "type": "object",
              "$comment": "accountName is required when Mimir or Loki is enabled. The objectStorage.validate helper checks it.",
              "properties": {
                "accountName": { "type": "string" }
              }
            },
            "buckets": {
              "type": "object",
              "required": ["mimirBlocks", "mimirAlertmanager", "mimirRuler", "loki"],
              "properties": {
                "mimirBlocks": { "type": "string", "minLength": 1 },
                "mimirAlertmanager": { "type": "string", "minLength": 1 },
                "mimirRuler": { "type": "string", "minLength": 1 },
                "loki": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
